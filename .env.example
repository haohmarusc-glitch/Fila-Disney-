# Crie o bot no @BotFather e pegue o token
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token-aqui
# Seu chat_id: mande /start pro bot e consulte https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Senha compartilhada para familiares liberarem o próprio chat com /entrar.
# Use uma senha longa e exclusiva. Vazio mantém acesso apenas ao chat acima.
FAMILY_ACCESS_PASSWORD=
# Token que o site manda em Authorization: Bearer. A API tem hostname próprio no
# Caddy (api-filadisney.premercadosc.com), então este token encara a internet:
# use um valor longo e aleatório. Ele nunca pode aparecer no JavaScript da página
# — quem injeta o header é o Caddy. Sem ele o container fila-disney-api não sobe.
WEB_API_TOKEN=

# Chave restrita a Routes API e, em producao, ao IP publico da VPS.
GOOGLE_MAPS_API_KEY=

# Opcional: URL do monitor Push do Uptime Kuma. Ausente = heartbeat desativado.
# Configure heartbeat de 5 min e grace period de 12 min no Uptime Kuma.
# Pode colar a URL exatamente como o painel do Kuma entrega, com o
# `?status=up&msg=OK&ping=` no fim: o monitor.py descarta a query antes de
# enviar. Ela precisa ser descartada — `status` duplicado faz o Kuma gravar a
# batida como DOWN e responder ok do mesmo jeito (ver `url_do_heartbeat`).
UPTIME_KUMA_PUSH_URL=
